        <mxCell id="legend" value="&lt;b&gt;Milly DB — conventions&lt;/b&gt;&lt;br&gt;PK — primary key · FK — foreign key · UQ — unique&lt;br&gt;&lt;br&gt;&lt;b&gt;Tenant integrity:&lt;/b&gt; composite FKs (id, user_id) keep related rows in the same user scope.&lt;br&gt;&lt;b&gt;Soft delete:&lt;/b&gt; projects, task_series, tasks, labels use deleted_at; partial unique indexes apply only to active rows.&lt;br&gt;&lt;b&gt;Deletion:&lt;/b&gt; deletion_batch_id groups cascades performed by the deletion job.&lt;br&gt;&lt;b&gt;Idempotency:&lt;/b&gt; reminder_deliveries is unique by (reminder_id, scheduled_for).&lt;br&gt;&lt;b&gt;Ownership rule:&lt;/b&gt; task_reminders has exactly one owner — task_id XOR series_id.&lt;br&gt;&lt;b&gt;Checked enums:&lt;/b&gt; priority, frequency, kind, status are restricted by CHECK constraints.&lt;br&gt;&lt;b&gt;PostgreSQL:&lt;/b&gt; bigint identity PKs, timestamptz, partial and expression indexes." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=10;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="360" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
