APP_NAME=Milly API
APP_ENV=local
DEBUG=false
API_V1_STR=/api/v1
ENABLE_DOCS=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=[]
ALLOWED_HOSTS=["*"]

POSTGRES_USER=milly
POSTGRES_PASSWORD=milly
POSTGRES_DB=milly
# Passwords embedded in DATABASE_URL and DIRECT_DATABASE_URL must be URL-safe.
DATABASE_URL=postgresql+asyncpg://milly:milly@localhost:6432/milly
DIRECT_DATABASE_URL=postgresql+asyncpg://milly:milly@localhost:5432/milly
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
SQL_ECHO=false

NATS_URL=nats://localhost:4222
NATS_USER=milly
NATS_PASSWORD=milly
NATS_STREAM=MILLY_TASKS
NATS_SUBJECT=milly.tasks
NATS_DURABLE=milly-workers
NATS_STREAM_MAX_AGE=604800
NATS_ACK_WAIT=300
NATS_MAX_DELIVER=5

# Password embedded in REDIS_URL must be URL-safe.
REDIS_URL=redis://:milly@localhost:6379/0
REDIS_PASSWORD=milly
TASKIQ_RESULT_EX_TIME=86400
TASKIQ_KEEP_RESULTS=true

PROVIDER_BASE_URL=
PROVIDER_API_KEY=
