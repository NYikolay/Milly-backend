APP_NAME=Milly API
APP_ENV=local
DEBUG=false
API_V1_STR=/api/v1
ENABLE_DOCS=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=[]
ALLOWED_HOSTS=["*"]
MAX_REQUEST_BODY_BYTES=1048576

POSTGRES_USER=milly
POSTGRES_PASSWORD=milly
POSTGRES_DB=milly
# Passwords embedded in DATABASE_URL and DIRECT_DATABASE_URL must be URL-safe.
DATABASE_URL=postgresql+asyncpg://milly:milly@localhost:6432/milly
DIRECT_DATABASE_URL=postgresql+asyncpg://milly:milly@localhost:5432/milly
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_TIMEOUT_SECONDS=10
SQL_ECHO=false

NATS_URL=nats://localhost:4222
NATS_USER=milly
NATS_PASSWORD=milly
NATS_STREAM=MILLY_TASKS
NATS_SUBJECT=milly.tasks
NATS_DURABLE=milly-workers
NATS_STREAM_MAX_AGE=604800
NATS_ACK_WAIT=300
NATS_MAX_DELIVER=5

# Password embedded in REDIS_URL must be URL-safe.
REDIS_URL=redis://:milly@localhost:6380/0
REDIS_PASSWORD=milly
TASKIQ_RESULT_EX_TIME=86400
TASKIQ_KEEP_RESULTS=true

PROVIDER_BASE_URL=
PROVIDER_API_KEY=

# Telegram Mini App auth. TELEGRAM_BOT_TOKEN and AUTH_JWT_SECRET are required in
# production and must not be committed.
# Dev placeholders. Replace both values in production; production validation
# rejects a token without ":" and a secret containing "change-me".
TELEGRAM_BOT_TOKEN=dev-telegram-bot-token
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_INIT_DATA_MAX_FUTURE_SKEW_SECONDS=60

AUTH_JWT_SECRET=dev-jwt-secret-change-me-32-chars
AUTH_JWT_ISSUER=milly
AUTH_JWT_LEEWAY_SECONDS=30
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_REFRESH_REUSE_GRACE_SECONDS=30
AUTH_REFRESH_COOKIE_NAME=milly_refresh
# Secure must be true behind HTTPS; false only for local HTTP development.
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax

# Admin panel. Leave ADMIN_PASSWORD empty to disable /admin. Production
# requires a strong password (16+ chars, no "change-me") when enabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_MAX_AGE_SECONDS=43200
